load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_src",
    srcs = glob([
        "**/*.c",
        "**/*.h",
    ]),
)

# Compatible string di DT X6871 "sliptswitch-gpio-audioswitch"
# (typo "slipt" memang dari vendor).
define_mgk_ddk_ko(
    name = "splitswitch-gpio",
    srcs = [
        "splitswitch-gpio.c",
    ],
)
