# SPDX-License-Identifier: GPL-2.0-only
# Infinix GT 20 Pro (X6871), applied after entry_level_legacy.config.
CONFIG_TC_CLASS_SUPPORT=m
CONFIG_TC_CHARGER=m
CONFIG_SND_SOC_FS1599=m
CONFIG_USB_SWITCH_ET7480=y
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_TRAN_FP_DRV_MODE_SPI=y
CONFIG_TRAN_HBM_NOTIFY_FINGERPRINT=y
CONFIG_TRANSSION_DOZE_BRIGHTNESS_SUPPORT=y
CONFIG_PXLW_IRIS=y
CONFIG_TRAN_FLASHLIGHT_TELE_SUPPORT=y
# Match the stock torch's low-battery behavior; leave DLPT and thermal policy alone.
# CONFIG_MTK_FLASHLIGHT_PT is not set
# CONFIG_MTK_FLASHLIGHT_PT_STRICT is not set

# 6.18: platform drivers below are provided out-of-tree on X6871.
