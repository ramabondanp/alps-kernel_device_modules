load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

filegroup(
    name = "ddk_makefile",
    srcs = glob([
        "**/Makefile",
        "**/Kbuild",
        "**/*.c",
        "**/*.h",
    ]),
)

define_mgk_ddk_ko(
    name = "gt9916_common",
    srcs = [
        "goodix_brl_fwupdate.c",
        "goodix_brl_hw.c",
        "goodix_brl_i2c.c",
        "goodix_brl_spi.c",
        "goodix_cfg_bin.c",
        "goodix_ts_core.c",
        "goodix_ts_gesture.c",
        "goodix_ts_utils.c",
    ],
    hdrs = glob(["*.h"]),
    includes = ["."],
    header_deps = [
        "//kernel_device_modules-{}/drivers/input/touchscreen/transsion/core:adaptive_ts_headers".format(kernel_version),
    ],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/input/touchscreen/transsion/core:adaptive-ts".format(kernel_version),
    ],
    copts = [
        "-DCONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=1",
    ],
)
