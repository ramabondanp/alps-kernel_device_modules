#
# NXP NCI based NFC I2C slave driver (pn560).

load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

# Compound module: the 6.1 donor Makefile names the composition
#   nfc_i2c-objs = common.o common_ese.o i2c_drv.o
# There is no nfc_i2c.c, which is why the first "no source" sweep missed it.
# See PLAN.md 6.1b.
define_mgk_ddk_ko(
    name = "nfc_i2c",
    srcs = [
        "common.c",
        "common_ese.c",
        "i2c_drv.c",
    ],
    hdrs = [
        "common.h",
        "common_ese.h",
        "i2c_drv.h",
    ],
    includes = ["."],
    copts = [
        "-DDYNAMIC_DEBUG_MODULE",
    ],
)
