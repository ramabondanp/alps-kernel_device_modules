load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version",)

package(

    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

filegroup(
    name = "ddk_srcs",
    srcs = glob([
          "**/*.c",
          "**/*.h",
    ]),
)

define_mgk_ddk_ko(
    name = "extcon-mtk-usb",
    srcs = [
        "extcon-mtk-usb.c",
    ],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/misc/mediatek/typec/tcpc:tcpc_class".format(kernel_version),
    ],
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    conditional_srcs = {
    },
    out = "extcon-mtk-usb.ko",
    copts = [
        "-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/typec/tcpc/inc",
    ],
)

# Transsion extcon USB driver.  The stock X6871 firmware ships only this
# module (not extcon-mtk-usb.ko) and its DTBO replaces the base
# "mediatek,extcon-usb" compatible with "transsion,extcon-usb".  It reports
# OTG changes to userspace through SWITCH_NAME/SWITCH_STATE uevents and uses
# the Transsion tc_tcpc notifier.
define_mgk_ddk_ko(
    name = "tran_extcon_usb",
    srcs = [
        "tran_extcon_usb.c",
    ],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/power/supply:tc_tcpc".format(kernel_version),
        "//kernel_device_modules-{}/drivers/power/supply:tc_common_class".format(kernel_version),
    ],
    includes = ["."],
    copts = [
        "-I$(DEVICE_MODULES_PATH)/drivers/power/supply/transsion",
        "-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/typec/tcpc/inc",
        "-I$(srctree)/drivers/extcon",
    ],
)
